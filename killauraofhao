-- ===== CHECK IF TYPING IN CHAT =====
local function isUserTyping()
    if TextChatService then
        local chatInputBar = TextChatService:FindFirstChild("ChatInputBar")
        if chatInputBar then
            local textBox = chatInputBar:FindFirstChild("TextBox")
            if textBox and textBox:IsA("TextBox") and textBox:IsFocused() then
                return true
            end
        end
    end
    
    local chat = CoreGui:FindFirstChild("Chat")
    if chat then
        local chatBar = chat:FindFirstChild("ChatBar")
        if chatBar then
            local textBox = chatBar:FindFirstChild("TextBox")
            if textBox and textBox:IsA("TextBox") and textBox:IsFocused() then
                return true
            end
        end
    end
    
    for _, obj in ipairs(CoreGui:GetDescendants()) do
        if obj:IsA("TextBox") and obj:IsFocused() then
            return true
        end
    end
    
    return false
end

-- ===== MS TIMING UTILITIES =====
local function getTimeMS()
    return tick() * 1000
end

local function waitMS(ms)
    if ms <= 0 then return end
    task.wait(ms / 1000)
end

-- ===== REMOTE DETECTION =====
local Remote = nil
local isRemoteEvent = false

local function findRemote()
    print("🔍 Scanning for attack remote...")
    
    local paths = {
        "Systems.ActionsSystem.Network.Attack",
        "Systems.Combat.Attack",
        "Combat.Attack",
        "Game.Attack",
        "Attack",
        "Remote.Attack",
    }
    
    for _, path in ipairs(paths) do
        local remote = ReplicatedStorage
        for part in string.gmatch(path, "[^%.]+") do
            remote = remote and remote:FindFirstChild(part)
            if not remote then break end
        end
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            print("✅ Found remote:", remote:GetFullName())
            return remote
        end
    end
    
    local function deepScan(folder)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local name = child.Name:lower()
                if name:find("attack") or name:find("combat") or 
                   name:find("damage") or name:find("hit") or name:find("melee") then
                    print("✅ Found remote via deep scan:", child:GetFullName())
                    return child
                end
            end
            if child:IsA("Folder") or child:IsA("Model") then
                local found = deepScan(child)
                if found then return found end
            end
        end
        return nil
    end
    
    return deepScan(ReplicatedStorage)
end

Remote = findRemote()
if Remote then
    isRemoteEvent = Remote:IsA("RemoteEvent")
else
    warn("❌ Could not find attack remote! Kill Aura may not work.")
end

-- ===== ENTITY MANAGEMENT =====
local EntityManager = {
    cache = {},
    lastScan = 0,
    
    refresh = function(self)
        local newCache = {}
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                -- ⛔ SKIP PROTECTED USERS
                if not PROTECTED_USERS[player.Name] then
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local hum = char:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            table.insert(newCache, {
                                character = char,
                                hrp = char.HumanoidRootPart,
                                humanoid = hum,
                                type = "player",
                                player = player,
                                id = player.UserId
                            })
                        end
                    end
                end
            end
        end
        
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Model") and child ~= LocalPlayer.Character then
                local hrp = child:FindFirstChild("HumanoidRootPart")
                local hum = child:FindFirstChild("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    local isDuplicate = false
                    for _, existing in ipairs(newCache) do
                        if existing.character == child then
                            isDuplicate = true
                            break
                        end
                    end
                    
                    if not isDuplicate then
                        local entityType = "entity"
                        local nameLower = child.Name:lower()
                        if nameLower:find("npc") then
                            entityType = "npc"
                        elseif nameLower:find("mob") then
                            entityType = "mob"
                        elseif nameLower:find("boss") then
                            entityType = "boss"
                        end
                        
                        table.insert(newCache, {
                            character = child,
                            hrp = hrp,
                            humanoid = hum,
                            type = entityType,
                            name = child.Name,
                            id = child
                        })
                    end
                end
            end
        end
        
        self.cache = newCache
        self.lastScan = tick()
    end,
    
    getNearest = function(self, origin, maxDist, exclude)
        local best = nil
        local bestDist = maxDist * maxDist
        
        for _, target in ipairs(self.cache) do
            if target.hrp and target.hrp.Position then
                if target.humanoid and target.humanoid.Health <= 0 then
                    -- Skip dead targets
                elseif exclude and target == exclude then
                    -- Skip excluded target
                else
                    local pos = target.hrp.Position
                    local dx = pos.X - origin.X
                    local dy = pos.Y - origin.Y
                    local dz = pos.Z - origin.Z
                    local distSq = dx*dx + dy*dy + dz*dz
                    
                    if distSq < bestDist then
                        bestDist = distSq
                        best = target
                    end
                end
            end
        end
        
        return best
    end,
    
    getThreeNearest = function(self, origin, maxDist)
        local targets = {}
        
        local first = self:getNearest(origin, maxDist)
        if not first then return {} end
        table.insert(targets, first)
        
        local second = self:getNearest(origin, maxDist, first)
        if second then
            table.insert(targets, second)
        end
        
        local third = self:getNearest(origin, maxDist, first)
        if third then
            table.insert(targets, third)
        end
        
        return targets
    end
}

-- ===== ATTACK SYSTEM =====
local function sendAttack(target, targetNum)
    if not target or not target.character then return false end
    if not Remote then return false end
    
    -- ⛔ DOUBLE-CHECK: Skip protected users
    if target.player and PROTECTED_USERS[target.player.Name] then
        return false
    end
    
    if rateLimitHit then
        if getTimeMS() - rateLimitRecoveryTime < 3000 then
            return false
        else
            rateLimitHit = false
            print("🔄 Rate limit recovered")
        end
    end
    
    local now = getTimeMS()
    local timeBetweenAttacks = CONFIG.AttackIntervalMS
    
    local lastTime = nil
    if targetNum == 1 then
        lastTime = lastAttackTime1
    elseif targetNum == 2 then
        lastTime = lastAttackTime2
    else
        lastTime = lastAttackTime3
    end
    
    if now - lastTime < timeBetweenAttacks then
        return false
    end
    
    local formats = {
        function() 
            if isRemoteEvent then
                Remote:FireServer(target.character, 1)
            else
                Remote:InvokeServer(target.character, 1)
            end
        end,
        function() 
            if isRemoteEvent then
                Remote:FireServer(target.character, target.humanoid, 1)
            else
                Remote:InvokeServer(target.character, target.humanoid, 1)
            end
        end,
        function() 
            if isRemoteEvent then
                Remote:FireServer(target.hrp, 1)
            else
                Remote:InvokeServer(target.hrp, 1)
            end
        end,
        function() 
            if isRemoteEvent then
                Remote:FireServer(target.character)
            else
                Remote:InvokeServer(target.character)
            end
        end,
        function() 
            if isRemoteEvent then
                Remote:FireServer(target.hrp, target.humanoid)
            else
                Remote:InvokeServer(target.hrp, target.humanoid)
            end
        end,
    }
    
    local success = false
    for _, format in ipairs(formats) do
        local result, err = pcall(format)
        if result then
            success = true
            break
        elseif err and string.find(err:lower(), "rate") then
            rateLimitHit = true
            rateLimitRecoveryTime = now
            print("⚠️ Rate limited! Pausing 3 seconds...")
            break
        end
    end
    
    if success then
        if targetNum == 1 then
            lastAttackTime1 = now
            attackCounter1 = attackCounter1 + 1
        elseif targetNum == 2 then
            lastAttackTime2 = now
            attackCounter2 = attackCounter2 + 1
        else
            lastAttackTime3 = now
            attackCounter3 = attackCounter3 + 1
        end
        totalAttacks = totalAttacks + 1
        return true
    end
    
    return false
end

-- ===== TRIPLE BURST ATTACK - MS TIMING =====
local function tripleBurstAttack(target1, target2, target3)
    if not target1 then return false end
    
    local success1 = false
    local success2 = false
    local success3 = false
    
    for i = 1, CONFIG.BurstSize do
        local startTime = getTimeMS()
        
        if target1 and sendAttack(target1, 1) then
            success1 = true
        end
        
        local elapsed = getTimeMS() - startTime
        local waitTime = CONFIG.AttackIntervalMS - elapsed
        if waitTime > 0 then
            waitMS(waitTime)
        end
        
        startTime = getTimeMS()
        
        if target2 and sendAttack(target2, 2) then
            success2 = true
        end
        
        elapsed = getTimeMS() - startTime
        waitTime = CONFIG.AttackIntervalMS - elapsed
        if waitTime > 0 then
            waitMS(waitTime)
        end
        
        startTime = getTimeMS()
        
        if target3 and sendAttack(target3, 3) then
            success3 = true
        end
        
        if i < CONFIG.BurstSize then
            elapsed = getTimeMS() - startTime
            waitTime = CONFIG.AttackIntervalMS - elapsed
            if waitTime > 0 then
                waitMS(waitTime)
            end
        end
    end
    
    return success1 or success2 or success3
end

-- ===== SINGLE TARGET BURST =====
local function singleTargetBurst(target)
    if not target then return false end
    
    local success = false
    for i = 1, CONFIG.BurstSize do
        local startTime = getTimeMS()
        
        if sendAttack(target, 1) then
            success = true
        end
        
        if i < CONFIG.BurstSize then
            local elapsed = getTimeMS() - startTime
            local waitTime = CONFIG.AttackIntervalMS - elapsed
            if waitTime > 0 then
                waitMS(waitTime)
            end
        end
    end
    
    return success
end

-- ===== MAIN ATTACK LOOP =====
local function attackLoop()
    if not isEnabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local now = getTimeMS()
    local minBurstInterval = 1000 / CONFIG.MaxBurstsPerSecond
    
    if now - lastBurstTime < minBurstInterval then
        return
    end
    
    if tick() - EntityManager.lastScan > CONFIG.ScanInterval then
        EntityManager:refresh()
    end
    
    if CONFIG.TripleTarget then
        local targets = EntityManager:getThreeNearest(hrp.Position, CONFIG.Range)
        if #targets > 0 then
            local target1 = targets[1]
            local target2 = targets[2]
            local target3 = targets[3]
            
            if target2 and target3 then
                tripleBurstAttack(target1, target2, target3)
                burstCounter = burstCounter + 1
                lastBurstTime = now
            elseif target2 then
                tripleBurstAttack(target1, target2, nil)
                burstCounter = burstCounter + 1
                lastBurstTime = now
            else
                singleTargetBurst(target1)
                burstCounter = burstCounter + 1
                lastBurstTime = now
            end
        end
    else
        local target = EntityManager:getNearest(hrp.Position, CONFIG.Range)
        if target then
            singleTargetBurst(target)
            burstCounter = burstCounter + 1
            lastBurstTime = now
        end
    end
end

-- ===== RENDER LOOP =====
local function onHeartbeat()
    if isEnabled then
        attackLoop()
    end
end

